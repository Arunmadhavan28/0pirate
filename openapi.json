{"info": {"description": "REST gateway mirror of the 0Pirate MCP tools, for GPT Actions / LangChain / non-MCP clients. Prefer native MCP (tools/list + tools/call) when available.", "title": "0Pirate Secure Proxy", "version": "0.2.1"}, "openapi": "3.1.0", "paths": {"/read_secure_file": {"post": {"operationId": "readSecureFile", "requestBody": {"content": {"application/json": {"schema": {"properties": {"file_path": {"description": "Absolute or relative path to the file.", "type": "string"}}, "required": ["file_path"], "type": "object"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"properties": {"abstracted_code": {"type": "string"}}, "type": "object"}}}, "description": "Abstracted safe code"}}}}, "/write_secure_file": {"post": {"operationId": "writeSecureFile", "requestBody": {"content": {"application/json": {"schema": {"properties": {"abstracted_code": {"description": "Edited code with placeholders intact.", "type": "string"}, "file_path": {"type": "string"}}, "required": ["abstracted_code", "file_path"], "type": "object"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"properties": {"message": {"type": "string"}}, "type": "object"}}}, "description": "Write result"}}}}, "/audit_status": {"post": {"operationId": "auditStatus", "requestBody": {"content": {"application/json": {"schema": {"properties": {"file_path": {"description": "Optional single file to audit.", "type": "string"}}, "type": "object"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"properties": {"report": {"type": "string"}}, "type": "object"}}}, "description": "Metadata-only audit report"}}}}}}
# 0Pirate Local Environment Configuration

# --- REQUIRED: Supabase (Authentication & Database) ---
# Create a free project at https://supabase.com
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# --- REQUIRED: Provider API Keys (Add at least one) ---
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# --- OPTIONAL: Redis (For rate limiting/caching) ---
# Automatically provided by the docker-compose setup
REDIS_URL=redis://redis:6379/0

# --- OPTIONAL: Razorpay (For billing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
